{
	"name": "sift",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Chrome extension that re-ranks Google results with TypeSafe Jev.",
	"scripts": {
		"build": "node build.mjs",
		"watch": "node build.mjs --watch",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"lint": "biome check .",
		"fix": "biome check --write .",
		"check": "npm run lint && npm run typecheck && npm test && npm run build",
		"smoke": "esbuild scripts/smoke.ts --bundle --platform=node --format=esm --log-level=warning | node --input-type=module"
	},
	"dependencies": {
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"@types/chrome": "^0.3.0",
		"@types/jsdom": "^30.0.0",
		"@types/node": "^22.20.3",
		"esbuild": "^0.28.2",
		"jsdom": "^30.1.0",
		"typescript": "^7.0.2",
		"vitest": "^5.0.1"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/tylergibbs1/sift.git"
	},
	"homepage": "https://github.com/tylergibbs1/sift#readme"
}
